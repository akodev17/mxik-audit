// Gate 1 owns only MxikCode — the classifier itself. The application tables
// (Organization, Catalog, Finding, AuditEvent) arrive in Gate 2.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, unaccent]
}

/// One row per 17-digit MXIK code, as published by tasnif.soliq.uz.
/// Column semantics are documented in docs/gate0-report.md.
model MxikCode {
  code String @id @db.Char(17)

  // Six-level hierarchy. Codes are slices of `code`; names come from the export.
  groupCode       String @db.Char(3)
  classCode       String @db.Char(5)
  positionCode    String @db.Char(8)
  subPositionCode String @db.Char(11)
  brandCode       String @db.Char(14)

  nameUz     String
  nameRu     String
  nameUzCyrl String

  groupNameUz           String?
  groupNameRu           String?
  groupNameUzCyrl       String?
  classNameUz           String?
  classNameRu           String?
  classNameUzCyrl       String?
  positionNameUz        String?
  positionNameRu        String?
  positionNameUzCyrl    String?
  subPositionNameUz     String?
  subPositionNameRu     String?
  subPositionNameUzCyrl String?
  brandNameUz           String?
  brandNameRu           String?
  brandNameUzCyrl       String?
  attributeNameUz       String?
  attributeNameRu       String?
  attributeNameUzCyrl   String?

  /// GTIN, normalized to 14 digits. Null for the 56% with no barcode.
  barcode String? @db.Char(14)

  /// Verbatim column J of the export, packaging detail included.
  unitRaw String?
  /// Acceptable canonical units. Column J is sometimes a comma-separated list.
  unitCanonical String[]
  /// Official unit ids resolved from unitCanonical; empty when unresolvable.
  unitIds       Int[]
  unitContainer String?
  unitQuantity  Float?
  /// strict = column J present (87.8%), recommended = only M/N, none = neither.
  unitBinding UnitBinding

  recommendedUnits      String[]
  recommendedUnitGroups String[]
  packagesRaw           String?
  taxPrivilegeIds       String[]

  /// Last six digits are 000000: the officially safe fallback for a subposition.
  isBase Boolean
  /// From the API `label` field. Null for the 8.7% the portal leaves unset.
  isMarked Boolean?

  /// Folded match keys for every name variant and both readings of ц.
  matchKeys String[]
  /// Concatenated searchable text, used for trigram and full-text retrieval.
  searchText String

  embeddingUz Unsupported("vector(384)")?
  embeddingRu Unsupported("vector(384)")?

  /// Generated column, defined in the search_indexes migration. Declared here so
  /// Prisma knows it exists and does not try to drop it; Prisma cannot manage
  /// GENERATED ALWAYS columns itself.
  searchVector Unsupported("tsvector")?

  /// Weighted full-text vector over the names and the hierarchy (A leaf, B
  /// position, C class/group, D brand/attribute). Filled by load:db or
  /// `npm run search:weighted`; see the weighted_search_vector migration.
  searchVectorWeighted Unsupported("tsvector")?

  /// Set when a later import no longer contains this code. See docs/gate0-report.md
  /// section 3: no source exposes deprecation, so this is populated by snapshot
  /// diffing and is null on a first import.
  retiredAt DateTime?

  importedAt DateTime @default(now())

  @@index([barcode])
  @@index([subPositionCode])
  @@index([groupCode])
  @@index([isBase])
  @@map("mxik_code")
}

enum UnitBinding {
  strict
  recommended
  none

  @@map("unit_binding")
}

/// The portal's tax-privilege reference (/integration-mxik/references/lgota):
/// what each id in mxik_code.taxPrivilegeIds means. Loaded by
/// `npm run privileges:fetch`; see docs/imtiyoz-data.md.
model TaxPrivilege {
  id          String    @id
  nameLatn    String?
  nameRu      String?
  docNum      Int?
  docDate     DateTime?
  docNameLatn String?
  fetchedAt   DateTime  @default(now())

  @@map("tax_privilege")
}

/// Generalized codes that EHF refuses from `effectiveFrom` on (construction
/// resources, tasnif.soliq.uz news 5063). Loaded from the official list by
/// `npm run load:restricted -- <xlsx>`; feeds the RESTRICTED finding.
model RestrictedCode {
  code          String   @id
  effectiveFrom DateTime @db.Date
  /// The list's own name for the code (Russian, else Uzbek), for operators.
  reason        String
  /// Where the list was published.
  source        String
  importedAt    DateTime @default(now())

  @@map("restricted_code")
}

/// Each catalogue import, so codes that vanish between imports can be detected.
model CatalogSnapshot {
  id         Int      @id @default(autoincrement())
  takenAt    DateTime @default(now())
  codeCount  Int
  source     String
  /// Codes present in the previous snapshot but absent from this one.
  retiredCodes String[]
  addedCount       Int       @default(0)
  retiredCount     Int       @default(0)
  unitChangedCount Int       @default(0)
  nameChangedCount Int       @default(0)
  /// When every client's latest catalogue was re-checked against this snapshot.
  recheckedAt      DateTime?

  changes ClassifierChange[]

  @@map("catalog_snapshot")
}

/// One code that changed in a classifier import, against the previous one.
model ClassifierChange {
  id         Int                  @id @default(autoincrement())
  snapshotId Int
  code       String               @db.Char(17)
  kind       ClassifierChangeKind
  before     Json?
  after      Json?

  snapshot CatalogSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, kind])
  @@index([code])
  @@map("classifier_change")
}

enum ClassifierChangeKind {
  added
  retired
  unit_changed
  name_changed

  @@map("classifier_change_kind")
}

/// Which provider produced the vectors currently stored in mxik_code.
/// Comparing embeddings from two different models is meaningless, so the vector
/// stage refuses to run when the query-time provider disagrees with this row.
model EmbeddingState {
  id           Int      @id @default(1)
  provider     String
  dimensions   Int
  rowsEmbedded Int
  updatedAt    DateTime @default(now())
  /// Vector columns holding this provider's vectors: "uz" (embeddingUz), "ru" (embeddingRu).
  columns      String[] @default(["uz"])

  @@map("embedding_state")
}

// ---------------------------------------------------------------- application

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users     User[]
  clients   Client[]
  notifications Notification[]
  telegramLinks TelegramLink[]
  orders    Order[]
  catalogs  Catalog[]
  events    AuditEvent[]
  invites   Invite[]
  mappings  FirmMapping[]
  feedback  SuggestionFeedback[]
  shareLinks ShareLink[]
  comments  FindingComment[]
  savedViews SavedView[]
  schedules ClientSchedule[]
  reminderTasks ReminderTask[]
  docLists  DocList[]
  reviewAssignments ReviewAssignment[]
  apiKeys   ApiKey[]
  usageLedger UsageLedger[]
  importBatches ImportBatch[]
  counterparties Counterparty[]
  onecConnection OneCConnection?
  products  Product[]
  bankFormats BankFormat[]
  bankRules BankRule[]
  didoxConnection DidoxConnection?
  didoxDocuments DidoxDocument[]
  /// Accept dictionary matches automatically when a catalogue is audited.
  dictAutoAccept Boolean @default(false)
  /// Free trial runs until this moment; null for demo and internal orgs.
  trialEndsAt DateTime?
  /// Paid firm subscription runs until this moment; null = none.
  subscriptionUntil DateTime?
  /// Firm name printed on client PDF reports; null = the org name.
  brandName String?
  /// Logo printed on client PDF reports (PNG or JPEG, small).
  logoData  Bytes?
  logoMime  String?
  /// Remembered column mapping, so a repeat upload does not re-ask.
  columnMap Json?
  kind      OrgKind  @default(customer)
  /// Demo copies are deleted after this by `npm run purge:expired`.
  expiresAt DateTime?
  /// The account was closed at this moment; restorable until the daily job purges it.
  deletedAt DateTime?
  /// Uploaded cells outside the mapped columns are blanked after this many days; null = keep.
  rawRetentionDays Int? @default(30)
  /// Retention applies only to uploads created after this moment (no retroactive purge).
  rawRetentionSince DateTime? @default(now())
  /// Minutes one review decision would take by hand: the dashboard's "time saved" estimate (D8), 1 to 60.
  minutesPerDecision Int @default(3)
  /// Codes this org confirmed per normalised product name (the global alias candidates' evidence).
  learnedAliases LearnedAlias[]

  @@index([kind, expiresAt])
  @@map("organization")
}

/// One organisation's confirmations of a code for a normalised product name
/// (match/alias.ts aliasKey). Written by learn() for individual and group
/// decisions only, never bulk accepts. Aggregated across organisations into
/// global alias candidates (docs/MATCHING_V2_PLAN.md §11); changes nothing by
/// itself.
model LearnedAlias {
  id            String   @id @default(cuid())
  orgId         String
  /// The folded, word-sorted product name; no unit.
  key           String
  /// The name as one organisation wrote it, for the admin page's examples.
  label         String
  code          String
  confirmations Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, key, code])
  @@index([key])
  @@map("learned_alias")
}

/// What a platform admin keeps on /admin/lexicon: synonym entries (a
/// normalize/synonyms.ts entry as JSON), unit aliases, and approved or rejected
/// global aliases. Only active rows are merged with the hand-written tables.
model LexiconEntry {
  id        String   @id @default(cuid())
  /// synonym | unit | alias
  kind      String
  /// active | disabled | rejected
  status    String
  /// Unique per kind: the folded forms of a synonym, the folded alias of a unit, "key|code" of an alias.
  key       String
  payload   Json
  note      String?
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@unique([kind, key])
  @@index([kind, status])
  @@map("lexicon_entry")
}

/// customer = a real client. demo_template = the seeded demo catalogue, never
/// signed into. demo = one visitor's throwaway copy of the template.
/// internal = our own seed, perf and test orgs; never counted as traction.
enum OrgKind {
  customer
  demo_template
  demo
  internal

  @@map("org_kind")
}

/// One row per demo session started. Demo orgs are purged after a day, so this
/// is the durable count for traction metrics. Holds nothing about the visitor.
model DemoVisit {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("demo_visit")
}

/// A request for demo access. The link e-mailed to `email` (only its hash is stored) opens a throwaway demo org once.
model DemoRequest {
  id         String    @id @default(cuid())
  /// As typed, lower-cased: where the link goes.
  email      String
  /// The address with provider aliases removed (dots and +tags), so one mailbox cannot be many demos.
  emailKey   String
  name       String
  company    String
  /// One of a fixed list of intended uses.
  useCase    String
  tokenHash  String    @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  /// The demo org the link opened; no relation, the org is purged when the demo ends.
  orgId      String?
  createdAt  DateTime  @default(now())

  @@index([emailKey, createdAt])
  @@index([createdAt])
  @@map("demo_request")
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  /// admin manages the org; accountant works on assigned clients; viewer is read-only.
  role         UserRole @default(admin)
  /// Set when the address was confirmed (or the account predates verification).
  emailVerifiedAt DateTime?
  /// How the address was confirmed: code, link (verify or reset mail), google, telegram, or legacy
  /// (confirmed before this was recorded). Null while unconfirmed. Google joins only code or link.
  verifiedVia String?
  emailTokens  EmailToken[]
  savedViews   SavedView[]
  /// Interface language, uz or ru; null = the default.
  locale       String?
  /// TOTP secret, encrypted (src/lib/security/totp.ts). Null = no two-factor.
  totpSecret    String?
  totpEnabledAt DateTime?
  /// Last accepted 30-second step, so one code cannot be used twice.
  totpLastStep  Int?
  recoveryCodes RecoveryCode[]
  sessions      UserSession[]
  notificationReads NotificationRead[]
  /// Catalogue reviews handed to this person.
  assignedReviews ReviewAssignment[] @relation("ReviewAssignee")
  /// Notifications addressed to this person alone.
  notices Notification[] @relation("NoticeTarget")
  /// Platform operator (cross-org admin pages). Set by hand in the database, never by email.
  platformAdmin Boolean @default(false)
  /// Telegram user id this person bound for signing in; separate from notification chats.
  telegramUserId String? @unique
  /// Google account (the ID token's sub) this person signs in with.
  googleSub String? @unique
  /// Guided tour finished or skipped; null = show it on the next visit.
  tourCompletedAt DateTime?
  /// This person hid the dashboard's "getting started" checklist; null = shown.
  onboardingHiddenAt DateTime?
  emailCodes EmailCode[]

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignments ClientAssignment[]

  @@index([orgId])
  @@map("user")
}

enum UserRole {
  admin
  accountant
  viewer

  @@map("user_role")
}

/// Limits an accountant or viewer to these clients; none assigned = all of the org's.
model ClientAssignment {
  userId    String
  clientId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
  @@index([clientId])
  @@map("client_assignment")
}

/// A link that lets one person join an org. Only the hash of the token is stored.
model Invite {
  id        String    @id @default(cuid())
  orgId     String
  tokenHash String    @unique
  email     String?
  role      UserRole
  clientIds String[]
  createdBy String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("invite")
}

/// What an org decided before: normalised name + unit (or a barcode) to a code.
model FirmMapping {
  id        String    @id @default(cuid())
  orgId     String
  /// name = normalised name + unit, barcode = the row's barcode.
  kind      String
  key       String
  /// The normalised name (or barcode) as shown in the dictionary page.
  label     String
  unit      String?
  code      String
  uses      Int       @default(1)
  createdBy String?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  /// Set when the code left the classifier; the mapping is then ignored.
  staleAt   DateTime?
  /// Individual (single-row) confirmations; bulk accepts do not count.
  confirmations Int @default(0)
  /// How the entry was last learned: manual, group, bulk, edit.
  source    String?
  /// Name entries: the size attributes in the key (noise.ts attrsKey); "" = none. Null = barcode, or not re-keyed yet.
  attrsKey  String?
  /// Auto-accept ignores the entry until an unscoped person confirms it again (re-key, code replaced, scoped learner, edit).
  needsReconfirm Boolean @default(false)
  /// A reviewer rejected or reported wrong a suggestion from this entry; cleared when an admin confirms or edits it.
  disputedAt DateTime?
  disputedBy String?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, kind, key])
  @@index([orgId])
  @@map("firm_mapping")
}

/// A reviewer's reason for calling a suggestion wrong; feeds the accuracy metrics.
model SuggestionFeedback {
  id            String   @id @default(cuid())
  orgId         String
  findingId     String   @unique
  userId        String?
  /// other_category, service_goods, finished_raw, unit or other.
  reason        String
  note          String?
  /// The pipeline stage and confidence label that produced the suggestion.
  stage         String?
  label         String?
  suggestedMxik String?
  productName   String
  createdAt     DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("suggestion_feedback")
}

/// A read-only report link for one catalogue. Only the token's hash is stored.
model ShareLink {
  id           String    @id @default(cuid())
  orgId        String
  catalogId    String
  tokenHash    String    @unique
  includePdf   Boolean   @default(true)
  createdBy    String?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  views        Int       @default(0)
  lastViewedAt DateTime?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  catalog Catalog      @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@index([catalogId])
  @@index([orgId])
  @@map("share_link")
}

/// One-time link that confirms an email address. Only the hash is stored.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  /// verify = confirm the address; reset = set a new password.
  purpose   String    @default("verify")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_token")
}

/// Six-digit codes that confirm an e-mail address (security/email-code.ts). Only a keyed hash is stored;
/// a new code retires the earlier ones.
model EmailCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  /// Wrong entries of this code; at the limit the code stops working.
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_code")
}

/// A note on one row. Internal: never shown on share links or in exports.
model FindingComment {
  id        String   @id @default(cuid())
  orgId     String
  findingId String
  userId    String?
  body      String
  createdAt DateTime @default(now())

  finding Finding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
  @@index([orgId])
  @@map("finding_comment")
}

/// A named set of workspace filters, sort, density and grouping. One default per user.
model SavedView {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  name      String
  params    Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_view")
}

/// When a client's monthly check is due (day of month 1-28) and who is told.
model ClientSchedule {
  clientId   String   @id
  orgId      String
  dayOfMonth Int
  /// The accountant to remind; null = the client's assigned accountants, else the admins.
  assigneeId String?
  enabled    Boolean  @default(true)
  /// The last month (YYYY-MM) a task was created for.
  lastPeriod String?
  updatedAt  DateTime @default(now())

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("client_schedule")
}

/// One monthly check to do. Open until a catalogue is audited for the client, or marked done.
model ReminderTask {
  id        String    @id @default(cuid())
  orgId     String
  clientId  String
  period    String
  dueOn     DateTime  @db.Date
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([clientId, period])
  @@index([orgId, doneAt])
  @@map("reminder_task")
}

/// An uploaded list of what a client sold: kind cheques (the tax cabinet's wrong-code list) or sales (cheque or EHF lines).
model DocList {
  id            String   @id @default(cuid())
  orgId         String
  clientId      String
  kind          String
  filename      String
  rowCount      Int
  headers       String[]
  columnMap     Json
  /// uploaded = waiting for the column mapping; analyzing; ready; failed.
  status        String   @default("uploaded")
  progressDone  Int      @default(0)
  progressTotal Int      @default(0)
  error         String?
  createdAt     DateTime @default(now())
  rawPurgedAt   DateTime?
  /// Check metadata: group total, truncation, diagnostics.
  meta          Json?

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  DocItem[]
  groups DocGroup[]

  @@index([clientId, kind])
  @@index([orgId])
  @@map("doc_list")
}

model DocItem {
  id         String    @id @default(cuid())
  listId     String
  rowIndex   Int
  name       String?
  mxik       String?
  unit       String?
  quantity   Decimal?  @db.Decimal(20, 3)
  amount     Decimal?  @db.Decimal(20, 2)
  occurredAt DateTime? @db.Date
  /// Every original cell, so the mapping can be applied after upload.
  attrs      Json

  list DocList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@map("doc_item")
}

/// Lines of a list that share a code (and, for cheques, a name), with what the checks found.
model DocGroup {
  id            String   @id @default(cuid())
  listId        String
  name          String?
  /// The most common names behind this group, for the report.
  names         Json
  mxik          String?
  unit          String?
  lines         Int
  quantity      Decimal? @db.Decimal(20, 3)
  amount        Decimal? @db.Decimal(20, 2)
  /// INVALID_CODE, MISSING_CODE, MISMATCH, UNIT_CONFLICT, NOT_IN_CATALOG, NOT_PURCHASED.
  issues        String[]
  suggestedMxik String?
  confidence    Float?
  /// Reasons, alternatives and matching catalogue rows.
  detail        Json

  list DocList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@map("doc_group")
}

enum CatalogStatus {
  uploaded
  analyzing
  ready
  failed

  @@map("catalog_status")
}

/// A business whose catalogues an organization audits. An accounting firm has
/// many; a company audits itself through its one default client.
model Client {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  /// Catalogues uploaded before clients existed, or without naming a client,
  /// land here. Exactly one per org (partial unique index in the migration).
  isDefault Boolean  @default(false)
  /// Decides how a sale without a matching purchase is rated (NOT_PURCHASED).
  activity  ClientActivity @default(boshqa)
  createdAt DateTime @default(now())
  /// Archived clients are hidden from lists and the switcher; their data is kept.
  archivedAt DateTime?

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  catalogs Catalog[]
  notifications Notification[]
  purchaseLists PurchaseList[]
  assignments ClientAssignment[]
  schedule ClientSchedule?
  reminderTasks ReminderTask[]
  docLists DocList[]
  reviewAssignments ReviewAssignment[]
  importBatches ImportBatch[]
  counterparties Counterparty[]
  products Product[]
  bankRules BankRule[]

  @@index([orgId])
  @@map("client")
}

/// savdo = trade (the purchase check is a high risk), ishlab_chiqarish =
/// production, boshqa = anything else; for the last two it is informational.
enum ClientActivity {
  savdo
  ishlab_chiqarish
  boshqa

  @@map("client_activity")
}

/// A client's purchases ("Kirim"), uploaded as a file of their choosing (an
/// EHF export or any list), mapped like a catalogue. Its MXIK codes are the
/// set the NOT_PURCHASED check compares sales against.
model PurchaseList {
  id        String   @id @default(cuid())
  orgId     String
  clientId  String
  filename  String
  rowCount  Int
  headers   String[]
  columnMap Json
  /// uploaded = waiting for the column mapping; ready = in use.
  status    String   @default("uploaded")
  createdAt DateTime @default(now())
  rawPurgedAt DateTime?
  /// Import metadata: sample rows for resuming the mapping, truncation, diagnostics.
  meta      Json?

  client Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items  PurchaseItem[]

  @@index([orgId])
  @@index([clientId])
  @@map("purchase_list")
}

model PurchaseItem {
  id       String  @id @default(cuid())
  listId   String
  rowIndex Int
  name     String?
  mxik     String?
  unit     String?
  /// Every original cell, so the mapping can be applied after upload.
  attrs    Json

  list PurchaseList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([mxik])
  @@map("purchase_item")
}

model Catalog {
  id        String        @id @default(cuid())
  orgId     String
  /// NOT NULL in the database: a BEFORE INSERT trigger fills the org's default
  /// client when a caller omits it (see the clients migration). Optional here
  /// only so callers that predate clients keep compiling.
  clientId  String?
  filename  String
  rowCount  Int
  status    CatalogStatus @default(uploaded)
  createdAt DateTime      @default(now())
  /// Header row as uploaded, so Export can reproduce the original shape.
  headers   String[]
  /// Which uploaded column feeds which field.
  columnMap Json
  /// Rows before this index are fully audited; a restarted audit resumes here.
  progressDone     Int       @default(0)
  auditStartedAt   DateTime?
  /// Bumped while an audit runs; a stale one means the worker died.
  auditHeartbeatAt DateTime?
  auditError       String?
  /// Set when the file came through the Telegram bot: the chat that gets the summary.
  telegramChatId   String?
  /// The earlier version of this client's catalogue this one replaces; decisions carry over from it.
  previousId       String?
  /// When the unmapped original cells were blanked by the retention job.
  rawPurgedAt      DateTime?
  /// The classifier snapshot the audit ran against (catalog_snapshot.id).
  snapshotId       Int?
  /// How the pipeline ran: embedder, reranker, degraded reasons, rows without AI.
  pipelineMeta     Json?
  /// What the import saw: rows seen, truncated, dropped rows, encoding, delimiter.
  importMeta       Json?

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client   Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items    CatalogItem[]
  shareLinks ShareLink[]
  reviewAssignment ReviewAssignment?

  @@index([orgId])
  @@index([clientId, createdAt])
  @@index([previousId])
  @@map("catalog")
}

model CatalogItem {
  id             String  @id @default(cuid())
  catalogId      String
  rowIndex       Int
  rawName        String
  normalizedName String
  barcode        String?
  existingMxik   String?
  unit           String?
  price          Decimal? @db.Decimal(18, 2)
  /// Sales amount from a mapped "Sotuv summasi" column, if the file has one.
  salesAmount    Decimal? @db.Decimal(20, 2)
  /// TIF TN (TN VED / HS) code from a mapped column: 4-10 digits, a lost leading zero restored.
  /// Its first four digits are the MXIK heading (MXIK digits 2-5); null when absent or unreadable.
  tnved          String?
  /// Attributes parsed out of the name, plus every original cell for re-export.
  attrs          Json
  /// The current code or a suggested code is flagged for digital marking
  /// (classifier `label` = 1). Set by the audit; drives the report filter.
  markingRequired Boolean @default(false)
  /// Set when the row's check still failed after its retries ("<kind>: <message>"): the row was
  /// not checked and is never shown or exported as "ok". Cleared when a re-check succeeds.
  checkError     String?

  catalog  Catalog   @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@unique([catalogId, rowIndex])
  @@index([catalogId])
  @@index([catalogId, markingRequired])
  @@map("catalog_item")
}

enum FindingType {
  /// No MXIK code on the row.
  MISSING
  /// Code present but not in the classifier. Also covers codes that were valid in
  /// an earlier import: no source exposes deprecation (docs/gate0-report.md §3),
  /// and the remedy is identical, so they are not split out yet.
  NOT_FOUND
  /// Code valid, but confidence against the product name is below 0.6.
  MISMATCH
  /// Row's unit contradicts the code's strictly bound unit.
  UNIT_CONFLICT
  /// The row's code is not among the client's purchase codes (savdo: high, else info).
  NOT_PURCHASED
  /// The row's code is linked to a tax privilege in the classifier: verify it fits.
  PRIVILEGE_CODE
  /// The suggested code is privilege-linked and the row's code is not.
  PRIVILEGE_OPPORTUNITY
  /// The row's code (on a MISSING row, the suggested one) is a generalized code
  /// EHF refuses from restricted_code.effectiveFrom on.
  RESTRICTED
  /// The row's valid code lies outside the heading of the row's own TIF TN (TN VED) code.
  TNVED_MISMATCH

  @@map("finding_type")
}

enum Severity {
  high
  medium
  /// Shown for information; never counted as risk.
  info

  @@map("severity")
}

enum Decision {
  pending
  accepted
  rejected

  @@map("decision")
}

model Finding {
  id            String      @id @default(cuid())
  itemId        String
  type          FindingType
  severity      Severity
  suggestedMxik String?
  confidence    Float?
  /// Runner-up candidates, each with code, name, path, confidence and reason.
  alternatives  Json
  reason        String
  /// Why the suggested code was proposed (src/core/match/evidence.ts). Null on older audits.
  evidence      Json?
  /// True when this code existed in an earlier snapshot and has since vanished.
  /// Carries the archive signal until there is enough history to surface it.
  wasRetired    Boolean     @default(false)
  /// The reviewer took this row out of its group of similar rows.
  groupSplit    Boolean     @default(false)
  /// The classifier import that caused this finding; null = the original audit.
  snapshotId    Int?
  decision      Decision    @default(pending)
  /// Code the reviewer actually chose, which may differ from suggestedMxik.
  chosenMxik    String?
  decidedBy     String?
  decidedAt     DateTime?
  /// The AuditEvent that set the current decision; undo targets it. Null while pending.
  decisionEventId String?
  /// ask_client = waiting on the client; resolved = settled. Null = no flag.
  flag          String?
  /// Where the current decision came from: manual, group, bulk, bulk_sure, dictionary, dictionary_auto, carry_over.
  decisionSource String?
  /// RESTRICTED only: the restricted code this finding is about, and when EHF stops accepting it.
  restrictedMxik String?
  restrictedFrom DateTime? @db.Date
  /// carry_over only: the catalogue the decision was first made in, and when (decidedAt is the carry-over time).
  carriedFromCatalogId String?
  originalDecidedAt    DateTime?

  item CatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  comments FindingComment[]

  @@index([itemId])
  @@index([decisionEventId])
  @@index([type])
  @@index([decision])
  @@index([flag])
  @@map("finding")
}

/// Append-only. Only `create` is ever called on this table. It is what a client
/// shows an inspector to demonstrate due diligence, and over time it becomes a
/// proprietary product-name-to-verified-MXIK dataset.
model AuditEvent {
  id        String   @id @default(cuid())
  orgId     String
  actorId   String?
  action    String
  targetId  String?
  payload   Json
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("audit_event")
}

/// Something an org should know about, shown in the app and sent to its linked
/// Telegram chats. Not an audit record: AuditEvent keeps that.
model Notification {
  id        String    @id @default(cuid())
  orgId     String
  clientId  String?
  /// e.g. classifier.updated
  kind      String
  title     String
  body      String
  /// Site-relative link to what the notification is about.
  href      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  /// Set once delivered to the org's Telegram chats; null = not sent (yet).
  telegramSentAt DateTime?
  /// Addressed to one person (e.g. a review assigned to them); null = everyone who may see the notice.
  userId    String?
  /// Names the event that produced it, so a retried job cannot raise it twice. Null = never deduplicated.
  dedupeKey String?
  /// Title and body in every interface language ({ "uz": { "title", "body" }, "ru": … }), so each reader gets theirs; null on older rows (title/body then).
  text      Json?

  user User? @relation("NoticeTarget", fields: [userId], references: [id], onDelete: Cascade)

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  reads  NotificationRead[]

  @@unique([orgId, dedupeKey])
  @@index([orgId, createdAt])
  @@index([clientId, createdAt])
  @@index([userId])
  @@map("notification")
}

enum ReviewStatus {
  open
  done

  @@map("review_status")
}

/// A catalogue review handed to one team member: by when, and the note that came with it. One per
/// catalogue; handing it to someone else (or changing the date or note) updates it and raises the revision.
model ReviewAssignment {
  id         String       @id @default(cuid())
  orgId      String
  clientId   String
  catalogId  String       @unique
  assigneeId String
  /// Who handed it over.
  createdBy  String?
  dueOn      DateTime?    @db.Date
  note       String?
  status     ReviewStatus @default(open)
  /// Bumped on every change of assignee, due date or note; part of the notification's dedupe key.
  revision   Int          @default(1)
  doneAt     DateTime?
  doneBy     String?
  doneNote   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client   Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  catalog  Catalog      @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  assignee User         @relation("ReviewAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  @@index([orgId, status, dueOn])
  @@index([assigneeId, status])
  @@index([clientId])
  @@map("review_assignment")
}

/// A Telegram chat linked to an org: receives notifications and may send files.
model TelegramLink {
  id        String   @id @default(cuid())
  orgId     String
  /// Telegram chat id, kept as text (it can exceed 2^31).
  chatId    String   @unique
  username  String?
  linkedBy  String?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("telegram_link")
}

/// One-time code shown in the web app; "/start CODE" in the bot links the chat.
model TelegramLinkCode {
  code      String    @id
  orgId     String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([orgId])
  @@map("telegram_link_code")
}

/// A file sent to the bot, waiting for the user to pick the client.
model TelegramPending {
  id        String   @id @default(cuid())
  chatId    String
  orgId     String
  fileId    String
  filename  String
  createdAt DateTime @default(now())

  @@index([chatId])
  @@map("telegram_pending")
}

/// A purchase: one "Toʻgʻrilangan katalog" for a catalogue, or a month of the
/// firm plan. Amount in soʻm, fixed when the order is created. Kept when the org is purged (orgId
/// becomes null, orgName says whose it was): the providers' CheckTransaction and GetStatement need it.
model Order {
  id          String      @id @default(cuid())
  orgId       String?
  /// The org's name when the order was made.
  orgName     String?
  catalogId   String?
  planId      String
  amount      Int
  status      OrderStatus @default(created)
  provider    String?
  /// Paid through a provider's sandbox (PAYME_TEST_MODE): no real money moved.
  testMode    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  paidAt      DateTime?
  cancelledAt DateTime?

  org          Organization?        @relation(fields: [orgId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]

  @@index([orgId, createdAt])
  @@index([catalogId])
  @@map("order")
}

enum OrderStatus {
  created
  paid
  cancelled

  @@map("order_status")
}

/// A payment provider's transaction for an order (Click or Payme), with the
/// state and times their protocols require us to remember.
model PaymentTransaction {
  /// Also Click's merchant_prepare_id / merchant_confirm_id, hence an integer.
  id           Int      @id @default(autoincrement())
  orderId      String
  provider     String
  /// click_trans_id or the Payme transaction id.
  externalId   String
  amountTiyin  BigInt
  /// Payme: 1 created, 2 performed, -1 cancelled before, -2 cancelled after.
  /// Click: 1 prepared, 2 completed, -1 cancelled.
  state        Int
  /// Provider-side creation time (Payme "time"), ms.
  providerTime BigInt?
  createTime   BigInt
  performTime  BigInt?
  cancelTime   BigInt?
  reason       Int?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([orderId])
  @@map("payment_transaction")
}

/// LLM rerank verdicts keyed by a hash of model + prompt version + normalized
/// name + unit. Scoped by org id (or "eval") so cached verdicts are never shared
/// across orgs and are deleted with the org's data. Read and written with raw
/// SQL in src/core/match/rerank-cache-pg.ts.
model RerankCache {
  scope     String
  key       String   @db.Char(64)
  model     String
  verdicts  Json
  createdAt DateTime @default(now())

  @@id([scope, key])
  @@map("rerank_cache")
}

/// A free-audit request from the landing page. Deliberately minimal: a file and
/// one way to reach the person. No email drip, no signup wall.
model Lead {
  id        String   @id @default(cuid())
  /// Phone or Telegram handle, as typed.
  contact   String
  company   String?
  filename  String?
  fileBytes Int?
  rowGuess  Int?
  /// Uploaded catalogue, held only until the audit is delivered.
  fileData  Bytes?
  note      String?
  createdAt DateTime @default(now())
  handledAt DateTime?
  /// When fileData was erased, on request or by retention (`npm run purge:expired`).
  fileDeletedAt DateTime?

  @@index([createdAt])
  @@map("lead")
}

/// A key for the public API. The token is shown once; only its hash is stored.
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  /// First characters of the token, so a key can be recognised in the list.
  prefix     String
  tokenHash  String    @unique
  createdBy  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usage ApiUsage[]
  idempotency ApiIdempotency[]

  @@index([orgId])
  @@map("api_key")
}

/// Consumption of a plan allowance (today only the monthly rows), one entry per committed catalogue.
/// Written in the transaction that commits the catalogue and never removed with it, so deleting a
/// catalogue does not give its rows back. usageOf sums an org's entries for the current month.
model UsageLedger {
  id        String   @id @default(cuid())
  orgId     String
  /// The limit consumed (billing/limits LimitKey): 'rowsPerMonth'.
  key       String
  amount    Int
  /// UTC start of the calendar month the entry counts in.
  period    DateTime
  /// The catalogue that consumed it. No relation: the entry outlives the catalogue. Unique per key,
  /// so a catalogue consumes once however often it is audited.
  catalogId String?
  /// 'catalog.committed', or 'backfill' for what was counted before the ledger existed.
  reason    String
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([catalogId, key])
  @@index([orgId, key, period])
  @@map("usage_ledger")
}

/// Calls per key and calendar month (UTC "YYYY-MM"): checks count against the plan allowance.
model ApiUsage {
  keyId    String
  orgId    String
  month    String
  checks   Int    @default(0)
  requests Int    @default(0)

  key ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([keyId, month])
  @@index([orgId, month])
  @@map("api_usage")
}

/// One-time codes that replace the authenticator app; only hashes are stored.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_code")
}

/// A signed-in browser. The cookie carries the id; revoking the row ends that session.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  orgId      String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_session")
}

/// Which user has read which notification.
model NotificationRead {
  userId         String
  notificationId String
  readAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([userId, notificationId])
  @@index([notificationId])
  @@map("notification_read")
}

/// One sign-in, two-factor or reset attempt, for rate limits that survive restarts.
model AuthAttempt {
  id        String   @id @default(cuid())
  /// e.g. password, password_ip, two_factor, reset, signup
  kind      String
  key       String
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
  @@map("auth_attempt")
}

/// First response to an API request with an Idempotency-Key header.
model ApiIdempotency {
  keyId     String
  idemKey   String
  status    Int
  response  Json
  createdAt DateTime @default(now())

  key ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([keyId, idemKey])
  @@map("api_idempotency")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// Accounting workflows (programme of 23 Oct 2026, docs/TASNIVO_AI_PLAN_2026-10-23.md).
// Shared models first (owned by Agent 1, 1C integration); then one section per workstream.
// Each workstream appends its own models inside its own section only, so the sections merge
// without conflicts. Every migration is additive (new tables, nullable columns, indexes).
// ═══════════════════════════════════════════════════════════════════════════════════════════

// ── Shared: import batches, records, counterparties (owner: Agent 1) ─────────────────────

/// What a batch came from and what it holds.
enum ImportKind {
  bank_statement
  didox_invoice
  product_catalog
}

/// uploaded → parsed → review → approved → exported; failed from any state.
enum ImportStatus {
  uploaded
  parsed
  review
  approved
  exported
  failed
}

/// A record's place in the review: valid as parsed, corrected by a person, suspicious (a
/// warning stands), unresolved (an error stands), skipped by a person, exported to 1C.
enum RecordStatus {
  valid
  corrected
  suspicious
  unresolved
  skipped
  exported
}

/// One source file or one pulled document set: a bank statement, a Didox invoice (one batch per
/// invoice), or a product catalogue export. Everything the accountant reviews hangs off a batch,
/// and every 1C export names the batch it came from (traceability).
model ImportBatch {
  id          String       @id @default(cuid())
  orgId       String
  /// The client the batch belongs to (firms keep one per client); null = the org's own books.
  clientId    String?
  kind        ImportKind
  /// 'upload' | 'didox_api' | 'didox_zip' | 'api' | 'telegram'.
  source      String
  filename    String?
  /// The source system's id (Didox document id, bank statement number); null for plain uploads.
  externalRef String?
  /// SHA-256 of the source bytes (or of the normalised external document). Unique per org and
  /// kind: the same file or document is refused as a duplicate import.
  fingerprint String
  status      ImportStatus @default(uploaded)
  /// Counts by RecordStatus plus total, kept current by the workstream that owns the kind.
  counts      Json?
  /// Kind-specific: the bank column mapping, the detected format, the Didox document header, the
  /// catalogue column map. Shape per kind is in packages/contracts/src/accounting.ts.
  meta        Json?
  error       String?
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client  Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  records ImportRecord[]
  exports OneCExport[]

  @@unique([orgId, kind, fingerprint])
  @@index([orgId, kind, createdAt])
  @@index([clientId, createdAt])
  @@map("import_batch")
}

/// One normalised record of a batch: a bank transaction, an invoice line, or a product. The
/// payload follows the zod schema of its kind in packages/contracts/src/accounting.ts
/// (BankTransaction, InvoiceLine, ProductRecord); issues are ValidationIssue[]; decision is the
/// reviewer's ReviewDecision; outcome is the 1C ImportOutcome for this record.
model ImportRecord {
  id          String       @id @default(cuid())
  batchId     String
  rowIndex    Int
  status      RecordStatus @default(valid)
  payload     Json
  issues      Json
  /// A per-record duplicate key within the org and kind (bank: date+amount+account+docNumber,
  /// invoice line: invoice externalRef + line number, product: normalised name + unit).
  fingerprint String?
  decision    Json?
  decidedBy   String?
  decidedAt   DateTime?
  outcome     Json?

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowIndex])
  @@index([batchId, status])
  @@index([fingerprint])
  @@map("import_record")
}

/// A counterparty known to the org (from 1C exports, earlier statements or invoices). Matching
/// is by ИНН/ПИНФЛ first, then account, then normalised name and aliases.
model Counterparty {
  id        String   @id @default(cuid())
  orgId     String
  clientId  String?
  /// 9-digit ИНН of a legal entity or 14-digit ПИНФЛ of an individual; null when unknown.
  inn       String?
  name      String
  /// Lower-cased, punctuation-free name used for matching.
  normalizedName String
  /// 20-digit settlement account and 5-digit МФО of its bank, when known.
  account   String?
  mfo       String?
  /// Other spellings seen in statements and invoices.
  aliases   String[]
  /// The 1C catalogue reference (code or GUID) once the counterparty is known to exist there.
  onecRef   String?
  /// 'onec_export' | 'bank_statement' | 'didox' | 'manual'.
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId, inn])
  @@index([orgId, normalizedName])
  @@index([orgId, account])
  @@map("counterparty")
}

/// One generated 1C import (a file download or a direct transfer) of a batch: what went, in which
/// format, and what came back. A batch may be exported more than once (a retry of failed rows).
model OneCExport {
  id          String   @id @default(cuid())
  batchId     String
  /// 'bank_exchange_1_02' | 'nomenclature_xlsx' | 'receipt_xlsx' | 'counterparties_xlsx' | 'odata' | 'http'.
  format      String
  filename    String?
  recordCount Int
  /// ImportOutcome summary: imported, skipped, rejected with reasons; per-record outcomes live on
  /// import_record.outcome.
  outcome     Json?
  /// The generated file (a download export); null for a direct transfer. Kept so the same file can
  /// be downloaded again and an idempotent repeat answers it unchanged.
  file        Bytes?
  contentType String?
  /// SHA-256 of format + the requested record ids ('*' = the batch's approved records): a repeat of
  /// the same request within a few minutes answers this export instead of a new one.
  requestKey  String?
  /// SHA-256 of the exported records' fingerprints, sorted: the same set exported again is flagged.
  recordSetHash String?
  createdBy   String?
  createdAt   DateTime @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
  @@index([recordSetHash])
  @@map("onec_export")
}

// ── Agent 1: 1C integration (connections, settings) ─────────────────────────────────────

/// The org's 1C settings: how bank-exchange files name the МФО, and an optional direct connection
/// (OData standard interface or an HTTP service of the client's 1C). One row per org.
model OneCConnection {
  id        String    @id @default(cuid())
  orgId     String    @unique
  /// 'none' (files only) | 'odata' | 'http'.
  kind      String    @default("none")
  /// The published base: `https://host/base` (OData answers under /odata/standard.odata/).
  baseUrl   String?
  username  String?
  /// The password, sealed with a key derived from SESSION_SECRET (AES-256-GCM, like the 2FA secrets).
  secret    String?
  /// Entity sets and attribute names per record kind (onec/connection.ts DEFAULT_OBJECT_MAP shape).
  objectMap Json?
  /// 'standard' (МФО in ПлательщикБИК/ПолучательБИК) | 'uz_mfo' (also ПлательщикМФО/ПолучательМФО).
  bankKeys  String    @default("standard")
  lastTestedAt DateTime?
  /// The last test's or transfer's error, without secrets; null after a successful test.
  lastError String?
  /// Whether the last connection test succeeded.
  lastOk    Boolean?
  updatedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("onec_connection")
}

// ── Agent 2: bank statements (formats, saved column mappings) ───────────────────────────

/// A bank statement layout the org taught Tasnivo by choosing its columns once (the manual
/// mapping step of /bank): the next file whose header signature matches is read with this
/// mapping and needs no mapping step. Built-in layouts live in code (packages/domain/src/bank/formats).
model BankFormat {
  id              String   @id @default(cuid())
  orgId           String
  /// What the user called it ("Kapitalbank, so'm"), shown when the format is recognised.
  name            String
  /// Normalised header names in column order joined with '|' (bank/formats/signature.ts).
  headerSignature String
  /// Role → source column index (BankColumnMap in packages/contracts/src/modules/bank.ts).
  columnMap       Json
  /// Date order, decimal mark, direction convention (BankConventions).
  conventions     Json
  /// Stays false until a real statement of that bank was read and checked against its totals.
  verified        Boolean  @default(false)
  usedCount       Int      @default(0)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, headerSignature])
  @@map("bank_format")
}

/// A deterministic statement-line rule: when a line matches (`kind` + `value`), its 1C operation
/// and cash-flow item are set, explained as `rule:<id>`. Remembered from a reviewer's correction
/// ("remember for this counterparty / purpose") or added by hand. Applied before the built-in
/// rules, highest priority first.
model BankRule {
  id           String   @id @default(cuid())
  orgId        String
  /// The client the rule was learnt for; null = every statement of the org.
  clientId     String?
  /// 'purpose_contains' | 'inn_equals' | 'counterparty_equals' | 'amount_sign'.
  kind         String
  /// The text to find (purpose), the ИНН, the normalised counterparty name, or 'debit' / 'credit'.
  value        String
  operation    String
  cashFlowItem String?
  priority     Int      @default(100)
  /// Statement lines this rule decided, counted when a statement is read.
  hits         Int      @default(0)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([orgId, clientId, priority])
  @@map("bank_rule")
}

// ── Agent 3: Didox invoices (connections, document cache) ───────────────────────────────

/// An org's Didox access (one per org). Two auth models exist (research note §1): 'token' = the
/// user's Didox token sent as api-key + user-key (Didox's 1C library), 'partner' = a partner
/// token as Bearer plus the user's token as user-key (npm SDK). The user's token is sealed with a
/// key derived from SESSION_SECRET; the partner token is never stored: partnerTokenRef names the
/// environment variable that holds it.
model DidoxConnection {
  id              String    @id @default(cuid())
  orgId           String    @unique
  /// The client synced invoices are filed under; null = the org's own books.
  clientId        String?
  /// 'token' | 'partner'.
  kind            String
  /// The company's ИНН (9) or ПИНФЛ (14) the token belongs to.
  companyTin      String
  tokenSealed     String?
  tokenExpiresAt  DateTime?
  partnerTokenRef String?
  lastSyncAt      DateTime?
  /// The last sync or test failure as a machine code (unauthorized, timeout, ...); null after a success.
  lastError       String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("didox_connection")
}

/// The raw Didox document as fetched (API) or uploaded (zip/JSON), keyed by its Didox id, with the
/// PDF print form when one came with it. The invoice's batch (import_batch, kind didox_invoice)
/// points back through externalRef; batchId is a plain column so the shared model stays untouched.
model DidoxDocument {
  id        String   @id @default(cuid())
  orgId     String
  /// The Didox document id (API), or the factura id / file fingerprint for uploads.
  didoxId   String
  /// 'didox_api' | 'didox_zip' | 'didox_json' | 'xlsx'.
  source    String
  docType   String?
  status    String?
  json      Json
  pdf       Bytes?
  batchId   String?
  fetchedAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, didoxId])
  @@index([batchId])
  @@map("didox_document")
}

// ── Agent 4: product catalogue and MXIK intelligence (products, packaging codes) ────────

/// A product the org (or one of its clients) buys or sells, as its 1C «Номенклатура» knows it.
/// One row per normalised name + unit within the org and client. Filled by the product catalogue
/// import, the audit's "Add to product catalogue" and the Didox workflow (upsertProducts); matched
/// by matchProducts. Confirmed MXIK codes are not kept a second time: a reviewer's confirmation
/// writes FirmMapping, the org's one source of confirmed mappings.
model Product {
  id              String    @id @default(cuid())
  orgId           String
  /// The client whose books the product belongs to; null = the org's own catalogue.
  clientId        String?
  name            String
  /// Folded name with sizes kept (packages/domain/src/products/keys.ts productNameKey); trigram-indexed.
  normalizedName  String
  /// Canonical unit id (as text) or the lower-cased unit; '' when none. Part of the identity.
  unitKey         String    @default("")
  /// 1C catalogue code or GUID, when the product came from a 1C export.
  onecRef         String?
  mxik            String?   @db.Char(17)
  mxikName        String?
  /// Tasnif packaging code (packaging_code.code) and its name.
  packageCode     String?
  packageName     String?
  unit            String?
  barcode         String?
  /// 'catalog_import' | 'audit' | 'didox' | 'manual'.
  source          String
  /// ProductRecord.mxikStatus: ok, missing, invalid, inactive, restricted, suspicious, unchecked.
  mxikStatus      String    @default("unchecked")
  /// ValidationIssue[] of the last classification.
  mxikIssues      Json?
  /// MatchCandidate of the last classification, when it suggested a code.
  mxikSuggestion  Json?
  /// Up to five runner-up MatchCandidates of the last classification, for the product drawer.
  mxikAlternatives Json?
  mxikCheckedAt   DateTime?
  /// Set when a reviewer confirmed `mxik` ("Confirm MXIK"); the mapping itself is in FirmMapping.
  mxikConfirmedAt DateTime?
  mxikConfirmedBy String?
  markingRequired Boolean?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  org     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client  Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  aliases ProductAlias[]

  // Identity: unique (orgId, COALESCE(clientId, ''), normalizedName, unitKey) and a trigram index
  // on normalizedName, both created in the migration (Prisma cannot declare them).
  @@index([orgId, clientId])
  @@index([orgId, mxik])
  @@index([orgId, barcode])
  @@index([orgId, onecRef])
  @@index([orgId, mxikStatus])
  @@map("product")
}

/// Another name the same product was seen under (an invoice line, an earlier spelling).
model ProductAlias {
  id              String   @id @default(cuid())
  productId       String
  /// Copied from the product so an alias is found by org without a join.
  orgId           String
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, normalizedAlias])
  @@index([orgId, normalizedAlias])
  @@map("product_alias")
}

/// One Tasnif packaging code of a classifier code (cls-api /mxik/get/by-mxik `packages[]`),
/// fetched lazily the first time a line needs a packaging check, then cached
/// (mxik_code_state.packagesFetchedAt). See docs/accounting-2026-10-23/tasnif-catalog.md.
model PackagingCode {
  /// The package id (`code`, e.g. 1074787); unique across the classifier.
  code          String   @id
  mxikCode      String   @db.Char(17)
  parentCode    String?
  containerCode Int?
  containerName String?
  unitId        Int?
  unitName      String?
  /// How many of the parent (or of the unit) the package holds, e.g. 14.
  parentValue   Float?
  name          String
  /// Raw `type` ("1" seen) and `isUnitPackage` ("1"/"2" seen); semantics not documented.
  type          String?
  isUnitPackage String?
  /// From /integration-mxik/get/history packageNames when fetched: "қадоқ=1 флакон * 14 дона".
  nameUz        String?
  nameRu        String?
  fetchedAt     DateTime @default(now())

  @@index([mxikCode])
  @@map("packaging_code")
}

/// What the live Tasnif API says about a code beyond the Excel export: activity
/// (/integration-mxik/get/history/{code} isActive/status) and whether its packages were fetched.
/// Filled on demand and for codes a classifier update finds missing from the export.
model MxikCodeState {
  code              String    @id @db.Char(17)
  /// isActive "1" → true, "0" → false; null = not asked, or the API did not say.
  isActive          Boolean?
  /// Raw `status` (only 0 seen so far).
  apiStatus         Int?
  /// The API answered "Mxik code not found!" for this code.
  apiNotFound       Boolean   @default(false)
  statusFetchedAt   DateTime?
  packagesFetchedAt DateTime?
  packageCount      Int?
  lastError         String?
  updatedAt         DateTime  @default(now()) @updatedAt

  @@map("mxik_code_state")
}

// ── Agent 5: platform quality ───────────────────────────────────────────────────────────

// ── Module flags (/admin/features) ──────────────────────────────────────────────────────

/// Whether a product module (packages/contracts/src/feature-modules.ts) is on, shown as
/// "coming soon", or hidden. No row = ENABLED.
model FeatureFlag {
  key       String       @id
  state     FeatureState
  updatedAt DateTime     @default(now()) @updatedAt

  @@map("feature_flag")
}

/// packages/contracts FEATURE_STATES.
enum FeatureState {
  ENABLED
  COMING_SOON
  HIDDEN

  @@map("feature_state")
}

{
  "name": "mxik-audit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "fetch:catalog": "tsx scripts/fetch-catalog.ts",
    "inspect:xlsx": "tsx scripts/inspect-xlsx.ts",
    "inspect:columns": "tsx scripts/inspect-columns.ts",
    "compare:langs": "tsx scripts/compare-langs.ts",
    "probe:api": "tsx scripts/probe-api.ts",
    "enumerate:group": "tsx scripts/enumerate-group.ts",
    "bench:enrich": "tsx scripts/bench-enrich.ts",
    "check:marking": "tsx scripts/check-marking-coverage.ts",
    "check:services": "tsx scripts/check-services.ts",
    "check:portal-examples": "tsx scripts/check-portal-examples.ts",
    "ingest": "tsx scripts/ingest-catalog.ts",
    "generate:units": "tsx scripts/generate-units.ts",
    "test": "node scripts/test.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "eval:translit": "tsx eval/translit.ts",
    "load:db": "tsx scripts/load-db.ts",
    "search:weighted": "tsx scripts/build-weighted-search.ts",
    "rekey:normalized": "tsx scripts/rekey-normalized.ts",
    "reaudit:diff": "tsx scripts/reaudit-diff.ts",
    "classifier:update": "tsx scripts/update-classifier.ts",
    "privileges:fetch": "tsx scripts/fetch-privileges.ts",
    "load:restricted": "tsx scripts/load-restricted.ts",
    "telegram:bot": "tsx scripts/telegram-bot.ts",
    "telegram:webhook": "tsx scripts/telegram-webhook.ts",
    "embed:catalog": "tsx scripts/embed-catalog.ts",
    "vectors:reindex": "tsx scripts/reindex-vectors.ts",
    "eval": "tsx eval/run.ts",
    "eval:fit": "tsx eval/fit-weights.ts",
    "eval:recall": "tsx eval/vector-recall.ts",
    "eval:synthetic": "tsx eval/make-synthetic.ts",
    "perf": "tsx scripts/perf-catalog.ts",
    "perf:nav": "tsx scripts/perf-nav.ts",
    "lint": "eslint apps/web/src apps/web/e2e apps/web/next.config.ts apps/api packages scripts eval tests apps/worker/src",
    "check:providers": "tsx scripts/check-providers.ts",
    "dev": "next dev apps/web -p 3000",
    "build": "next build apps/web",
    "start": "next start apps/web",
    "dev:api": "tsx watch --clear-screen=false apps/api/src/main.ts",
    "build:api": "node apps/api/scripts/build.mjs",
    "start:api": "node --enable-source-maps apps/api/dist/main.mjs",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "build:worker": "node apps/worker/build.mjs",
    "start:worker": "node --enable-source-maps apps/worker/dist/main.js",
    "worker:smoke": "tsx scripts/worker-smoke.ts",
    "seed": "tsx packages/db/prisma/seed.ts",
    "seed:audit": "tsx scripts/audit-catalog.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "make:demo-catalog": "tsx scripts/make-demo-catalog.ts",
    "demo:quality": "tsx scripts/demo-quality.ts",
    "purge:expired": "tsx scripts/purge-expired.ts",
    "lead:delete": "tsx scripts/lead-delete.ts",
    "password:set": "tsx scripts/set-password.ts",
    "capture": "tsx scripts/capture-screenshots.ts",
    "make:sample": "tsx scripts/make-sample-file.ts",
    "make:sample-report": "tsx scripts/make-sample-report.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.39.5",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "grammy": "^1.46.0",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "prisma": "^6.19.3",
    "sax": "^1.4.1",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma",
    "seed": "tsx packages/db/prisma/seed.ts"
  }
}

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mxik-audit",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mxik-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "apps/web",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "mxik-dev-3001",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "apps/web",

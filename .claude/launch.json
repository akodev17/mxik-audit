      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 4000
    },
    {
      "name": "tasnivo-api-4015",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:API_PORT='4015'; npm run dev:api"
      ],
      "port": 4015
    },
    {
      "name": "tasnivo-web-3015",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:API_INTERNAL_URL='http://localhost:4015'; npx next dev apps/web -p 3015"

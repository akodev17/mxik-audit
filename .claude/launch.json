{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mxik-audit",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mxik-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "apps/web",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "mxik-dev-3001",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "apps/web",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "mxik-api-4000",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 4000
    },
    {
      "name": "tasnivo-api-4015",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:API_PORT='4015'; npm run dev:api"],
      "port": 4015
    },
    {
      "name": "tasnivo-web-3015",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:API_INTERNAL_URL='http://localhost:4015'; npx next dev apps/web -p 3015"],
      "port": 3015
    },
    {
      "name": "tasnivo-web-3015-prod",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:API_INTERNAL_URL='http://localhost:4015'; npx next start apps/web -p 3015"],
      "port": 3015
    }
  ]
}

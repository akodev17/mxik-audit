{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mxik-audit",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mxik-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "apps/web",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "mxik-dev-3001",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "apps/web",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "mxik-api-4000",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 4000
    },
    {
      "name": "agent1-api-4011",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:API_PORT='4011'; npm run dev:api"
      ],
      "port": 4011
    },
    {
      "name": "agent1-web-3011",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:API_INTERNAL_URL='http://localhost:4011'; npx next dev apps/web -p 3011"
      ],
      "port": 3011
    }
  ]
}

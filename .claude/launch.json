{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mxik-audit",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mxik-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "apps/web",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "mxik-dev-3001",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "apps/web",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "mxik-api-4000",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 4000
    },
    {
      "name": "tasnivo-api-4014",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:API_PORT='4014'; npm run dev:api"
      ],
      "port": 4014
    },
    {
      "name": "tasnivo-web-3014",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:API_INTERNAL_URL='http://localhost:4014'; npx next dev apps/web -p 3014"
      ],
      "port": 3014
    },
    {
      "name": "tasnivo-api-4013",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:API_PORT='4013'; npm run dev:api"
      ],
      "port": 4013
    },
    {
      "name": "tasnivo-web-3013",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:API_INTERNAL_URL='http://localhost:4013'; npx next dev apps/web -p 3013"
      ],
      "port": 3013
    }
  ]
}

# One .env at the repository root serves every service: docker-compose.yml passes it to web, api,
# worker and bot, and overrides DATABASE_URL, REDIS_URL, JOBS_MODE and DATA_DIR with the
# addresses inside the compose network. Sections are grouped by the service that reads them.
# Secrets to set on any server: POSTGRES_PASSWORD, SESSION_SECRET, CRON_SECRET, SMTP_URL (DEPLOY.md 3).

# === Stack (docker-compose: caddy, db, redis, backup) ============================

# Public domain. Caddy obtains HTTPS certificates for it and for www.<domain>, which
# redirects to it (infra/Caddyfile). Unset = localhost (no public certificate).
SITE_DOMAIN=tasnivo.uz
# Database password for docker-compose (db, backup and the apps' DATABASE_URL). Set a long
# random value on any server; the default "mxik" is for local development only.
POSTGRES_PASSWORD=
# Where Caddy sends /api/*. Default api:4000. During the move of the routes into apps/api
# (plan, Wave 2–4) web:3000 keeps the Next.js app answering them as before.
# API_UPSTREAM=web:3000
# Caddy on http://localhost:8080 (`docker compose --profile local up caddy-local`) proxies to the
# dev servers on the host by default; web:3000 / api:4000 test the containers instead.
# LOCAL_WEB_UPSTREAM=host.docker.internal:3000
# LOCAL_API_UPSTREAM=host.docker.internal:4000

# === Shared by api, worker and bot (the web app reads none of these) =============

# Local dev database (docker-compose). Host port 54329 avoids the 5432/5433
# already in use by other projects on this machine.
# 127.0.0.1 rather than localhost: on Windows "localhost" tries IPv6 first and each new connection waits ~2 s.
DATABASE_URL="postgresql://mxik:mxik@127.0.0.1:54329/mxik?schema=public"
# BullMQ's Redis (docker-compose service redis; host port 63799 in development).
REDIS_URL=redis://127.0.0.1:63799
# bullmq = the api enqueues audits, document checks, mail and Telegram delivery and the worker
# runs them. inline (or unset) = they run in the process that starts them, as before the split;
# keeps tests and a single dev server simple. docker-compose sets bullmq.
# JOBS_MODE=bullmq
# Embedding models, the classifier status file, update log and downloads. Unset = ./data under
# the working directory (the repository root). docker-compose sets /app/data, the mounted ./data,
# which is the same folder. Reserved: as of Wave 1 the code still resolves data/ against the
# working directory and does not read this yet.
# DATA_DIR=

# 32+ characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Also keys the two-factor secrets, recovery codes and rate-limit records: rotating it
# makes existing two-factor setups and recovery codes stop working (DEPLOY.md 7g).
# The api unseals the same session cookie the web app sets: never rotate it during the migration.
SESSION_SECRET=

# Public origin of the app (https://...): links in e-mails and Telegram messages, return links
# after payment, the OpenAPI document's server, `npm run telegram:webhook`. Falls back to
# NEXT_PUBLIC_SITE_URL. Production: https://tasnivo.uz
APP_URL=

# Email (sign-up verification codes, invites, password reset). REQUIRED in production: without
# both, sign-up is refused (the verification code cannot be sent; verification is never skipped).
# In development, unset = every message is written to the API log and to tmp/outbox/<time>.txt
# instead (read the sign-up code there). Gmail: an app password, see DEPLOY.md 7c, e.g.
#   SMTP_URL=smtps://you%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465
# Check delivery with `npm run mail:test -- you@example.com`.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Tasnivo <no-reply@tasnivo.uz>"
# Development fallback directory, default tmp/outbox.
# MAIL_OUTBOX_DIR=

# Google sign-in ("Google orqali kirish" on /sign-in and /sign-up). Both unset = the button is
# hidden. Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application);
# authorised redirect URI: https://tasnivo.uz/api/auth/google/callback (DEPLOY.md 7c).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only when the redirect URI differs from APP_URL + /api/auth/google/callback (e.g. local testing:
# http://localhost:3000/api/auth/google/callback).
# GOOGLE_REDIRECT_URI=

# Time zone: none to set. The apps always use Asia/Tashkent (UTC+5) for dates, and the worker's
# schedule and the backup keep UTC+5 on their own.

# === api (NestJS, apps/api) ======================================================

# HTTP port. Caddy and the web app's server-side rendering reach it as api:4000 in compose.
API_PORT=4000

# A proxy in front sets the client address (X-Real-IP, X-Forwarded-For) for the per-address rate
# limits: 1 behind Caddy or nginx (docker-compose sets it for the api); 0 = the headers are the
# client's own words and are ignored, the socket address is used. Unset: 0 when NODE_ENV=production,
# else 1 (dev servers, e2e runs and probes name their client in X-Real-IP).
# TRUST_PROXY=1

# The first-party Swagger (/api/docs, /api/docs-json) lists every internal route; with NODE_ENV=production
# it is served only when this is 1. The public API's contract is /api/v1/openapi.json either way.
# API_DOCS_PUBLIC=

# Bearer token for POST /api/cron/classifier-update and /api/cron/daily (16+ characters), for an
# external scheduler. Unset = those routes answer 503; the worker's own schedule needs no token.
CRON_SECRET=

# --- Payments (Click, Payme) ---------------------------------------------------
# A provider is on only when all of its values are set; with none set there are
# no pay buttons, and Settings says that no payment provider is configured.
# Every price (subscriptions monthly and yearly, one-off catalogues) and every plan limit lives in
# packages/domain/src/billing/plans.ts, the same numbers the landing page shows (docs/PRICING_PROPOSAL.md).
# A bank transfer received by hand is recorded with: npm run billing:activate -- --org <id or e-mail> --plan <id>
# Click SHOP API: Prepare and Complete URL = https://tasnivo.uz/api/payments/click
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Payme Merchant API: endpoint = https://tasnivo.uz/api/payments/payme
PAYME_MERCHANT_ID=
PAYME_KEY=
# Sandbox: true = checkout.test.paycom.uz and PAYME_TEST_KEY instead of PAYME_KEY.
PAYME_TEST_MODE=false
PAYME_TEST_KEY=
# 1 = Payme test mode stays on with NODE_ENV=production (a staging server on the sandbox; the orders it
# confirms are marked testMode). Unset (default) = test mode switches Payme off in production.
# PAYME_TEST_ALLOW_PROD=1
# true = the corrected file downloads only after a paid order for that
# catalogue or an active subscription. false here keeps local development free;
# production sets true (DEPLOY.md 7b), because the landing page says the free plan has no corrected file.
BILLING_REQUIRED_FOR_EXPORT=false
# Web build: true = the landing pricing note also says the app takes Click/Payme (set once a
# provider above is configured). Unset = it mentions the bank transfer only.
NEXT_PUBLIC_ONLINE_PAYMENT=

# --- Demo, admin and accounts ----------------------------------------------------
# Demo access (/demo): a visitor asks with name, company and e-mail; the link sent to that address (SMTP_URL and
# MAIL_FROM must be set in production, or demo requests are refused) opens a private copy of the sample catalogue.
# Hours a demo lasts at most from the moment its link is used. Enforced on every request; the copy is deleted
# afterwards by the worker's purge job (`npm run purge:expired`).
DEMO_TTL_HOURS=24
# Minutes without a request after which a demo session ends.
DEMO_IDLE_MINUTES=30
# Minutes the e-mailed link stays valid (it works once).
DEMO_LINK_MINUTES=30
# Demos one mailbox may open per day (Gmail dots and +tags count as the same mailbox).
DEMO_MAX_PER_EMAIL=3
# Files (corrected file, PDF, CSV) one demo may download before it must be restarted.
DEMO_MAX_EXPORTS=10
# Demo copies alive at once.
DEMO_MAX_LIVE=500
# Extra throwaway e-mail domains to refuse, comma-separated (a built-in list applies as well).
DEMO_BLOCKED_DOMAINS=
# Who may open /admin (traction metrics across all customers) and /admin/features (switch product
# modules on, to "coming soon" or hidden), comma-separated; everyone else gets a 404 there.
# Empty = nobody. Being listed is not enough: the user also needs the platformAdmin
# flag (set by hand in the database, DEPLOY.md 7g) and a confirmed address.
ADMIN_EMAILS=

# Plan limits (clients, rows per month, seats, API checks per month) are not settings: they are in
# packages/domain/src/billing/plans.ts with the prices, so the app enforces what the landing promises.
# The PLAN_TRIAL_* / PLAN_FIRM_* / PLAN_FIRM_PRICE / API_CHECKS_PER_MONTH_* variables are no longer read.
# Uncommitted upload previews (not settings, for reference): they do not use the monthly rows, so
# a user's new upload replaces their open preview, an org's open preview rows from the last 24 hours
# are capped at its monthly row limit (200,000 when unlimited), and the daily job deletes previews
# older than 48 hours (DEPLOY.md 7d).

# Public API (/api/v1). Rate limit per key per minute (in memory, per process) and the most
# products in one check (the monthly check allowance is each plan's, see above).
# Every response to a valid key carries X-RateLimit-Limit / X-RateLimit-Remaining; Idempotency-Key
# rows are kept 24 hours and pruned by the daily job.
# API_RATE_PER_MINUTE=60
# API_CHECK_MAX_ITEMS=20
# Checks one API process runs at once; beyond it /api/v1/check answers 429 rate_limited with Retry-After.
# API_CHECK_CONCURRENCY=4

# 1C (OData) connections. 1 = in production a 1C base URL may resolve to a private or loopback address
# (a self-hosted install next to the client's 1C). Unset (default) = public addresses only, so the
# server cannot be used as a proxy into its own network. Development and tests never check.
# ONEC_ALLOW_PRIVATE_HOSTS=1

# Didox incoming invoices (packages/domain/src/didox; DEPLOY.md "Didox"). Each org pastes its own token
# in Didox → Ulanish (stored sealed). Unset host = api.didox.uz for company tokens (api-key + user-key),
# api-partners.didox.uz for partner mode (Partner-Authorization + user-key).
# DIDOX_API_URL=http://127.0.0.1:4923   # a proxy, or the local fake: npx tsx packages/domain/src/didox/fake-server.ts
# DIDOX_SANDBOX=1                        # Didox's test server testapi3.didox.uz (E-IMZO test key from my3.soliq.uz)
# DIDOX_PARTNER_TOKEN=                   # partner token from Didox's account manager; orgs may name another DIDOX_* variable
# DIDOX_PASSWORD_LOGIN=1                 # offer INN + password login (the password is never stored)
# DIDOX_LIVE=1                           # tests only: run the opt-in live test on the public measures list

# === worker (NestJS + BullMQ, apps/worker) =======================================
# Audits, document checks, mail, Telegram delivery and the schedule (purge 03:15, classifier
# update 04:00, daily jobs 06:15, UTC+5). The matching settings below are also read by the api
# for the synchronous POST /api/v1/check.

# Port of GET /healthz (the container healthcheck); not published.
WORKER_PORT=4100

# --- Optional providers -------------------------------------------------------
# Without a key the matching pipeline still runs, but degraded: stage 6 (LLM
# rerank) is skipped and confidence is capped at 0.85, and stage 4 falls back to
# a local non-semantic stand-in. `npm run eval` prints a warning when that happens.

# Stage 6. Enables LLM reranking of uncertain rows. Only the cleaned product
# name, the row's unit and a derived prepared-dish flag are sent, plus public
# classifier candidates — never prices, company data, barcodes or other columns.
# Provider: gemini | anthropic | off. Empty = Gemini when GEMINI_API_KEY is set,
# else Anthropic when ANTHROPIC_API_KEY is set, else off. An explicit choice
# never falls back to the other provider.
RERANK_PROVIDER=

# Google Gemini (Generative Language API, plain REST, key sent as x-goog-api-key).
GEMINI_API_KEY=
# Measured in docs/scoring.md ("Reranker on (Gemini)"). The 2.5 models answer 404
# to keys created after Oct 2026. Prices: https://ai.google.dev/gemini-api/docs/pricing
GEMINI_MODEL=gemini-3.1-flash-lite
# Gemini 3: minimal | low | medium | high (empty = the model's default, high).
# Gemini 2.5: GEMINI_THINKING_BUDGET in tokens, 0 = off, -1 = dynamic.
GEMINI_THINKING_LEVEL=
GEMINI_THINKING_BUDGET=
# USD per million tokens for the cost estimate; empty = built-in table (dated in rerank-config.ts).
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=
# Endpoint override, for tests and proxies. Empty = https://generativelanguage.googleapis.com
MXIK_GEMINI_BASE_URL=

# Anthropic Claude.
ANTHROPIC_API_KEY=
# Current model IDs: https://platform.claude.com/docs/en/models/overview
# Default claude-opus-5-5 ($4/$20 per MTok). claude-sonnet-5-5 ($2/$10) and
# claude-haiku-5-5 ($0.10/$0.50) are cheaper; run `npm run eval` before switching.
ANTHROPIC_MODEL=claude-opus-5-5
# Kill switch: false = never call the LLM, even with a key (the cap then applies).
MXIK_LLM_ENABLED=true
# low | medium | high | xhigh | max. Empty = omit (for models that reject it).
ANTHROPIC_EFFORT=low
# Server-side refusal fallback on models that support it; "off" to disable.
ANTHROPIC_FALLBACKS=default
# Endpoint override. Deliberately not ANTHROPIC_BASE_URL, which agent tooling sets.
MXIK_ANTHROPIC_BASE_URL=
# Which rows are sent: top-1 retrieval confidence below RERANK_GATE_CONFIDENCE,
# or top-1 minus top-2 below RERANK_GATE_MARGIN. Set confidence to 1.01 to send
# every fuzzy row. Rows not sent stay capped below the bulk-accept band.
RERANK_GATE_CONFIDENCE=0.95
RERANK_GATE_MARGIN=0.1
# Both providers: rows per API call (max 25), how long to wait to fill a batch
# (max 10000 ms), calls in flight at once, per-call timeout and retries. Retries
# back off on 429/5xx/timeouts and honour the server's retry delay; a daily quota
# fails the batch at once and its rows keep the capped ranking.
# Gemini free tier (20 requests a day per model): RERANK_BATCH_SIZE=25,
# RERANK_BATCH_WAIT_MS=5000, RERANK_MAX_CONCURRENT=2, RERANK_TIMEOUT_MS=300000.
RERANK_BATCH_SIZE=8
RERANK_BATCH_WAIT_MS=30
RERANK_MAX_CONCURRENT=4
RERANK_TIMEOUT_MS=60000
RERANK_MAX_RETRIES=2
# USD per million tokens, for the cost estimate only (both providers; the
# GEMINI_PRICE_* pair wins for Gemini). Empty = built-in table.
RERANK_PRICE_INPUT_PER_MTOK=
RERANK_PRICE_OUTPUT_PER_MTOK=

# Stage 4. Either one works; Voyage is checked first. Both are multilingual and
# are asked to project to the 384 dimensions the schema pins.
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Recommended (P1.1): "local" = multilingual-e5-small on this server's CPU. No
# key, no cost, nothing leaves the server; its dense vectors let HNSW work, which
# audits ~8x faster than the stand-in's exact scan. Used by `npm run
# embed:catalog`; at query time the app uses whatever model produced the stored
# vectors, so changing this does nothing until the catalogue is re-embedded.
EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=multilingual-e5-small   # or paraphrase-multilingual-minilm
# LOCAL_MODEL_DIR=data/models                   # weights, downloaded once (~470 MB)
# LOCAL_EMBED_THREADS=4                          # 4 measured faster than 8 on a 16-thread CPU
# LOCAL_EMBED_DEVICE=cpu                         # dml = Windows GPU, ~8x faster backfill (not in Docker)
# "hashing" = the non-semantic stand-in (no download, but exact vector scans).
# Unset = Voyage/OpenAI when a key above is set, else the stand-in.
# EMBEDDING_PROVIDER=hashing
# Model names and throughput for `npm run embed:catalog`.
# VOYAGE_MODEL=voyage-3
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_CONCURRENCY=8
# EMBED_BATCH=2000

# --- Matching performance -------------------------------------------------------
# Trigram retrieval first runs at this stricter word_similarity threshold and
# falls back to pg_trgm's default 0.6 only when that pass does not fill the
# candidate list; the candidates are identical either way, only faster on names
# with common words ("труба ..."). "off" = one query at the default. Default 0.75.
# LEXICAL_STRICT_THRESHOLD=0.75

# --- Classifier updates and retention ------------------------------------------
# Where an update started over HTTP writes its log (default data/classifier-update.log).
# CLASSIFIER_UPDATE_LOG=
# Days a demo request (name, company, e-mail) is kept before the purge job deletes it.
DEMO_REQUEST_RETENTION_DAYS=90
# Days a landing-page lead's uploaded file is kept before the purge job erases it.
# On request, erase immediately with `npm run lead:delete -- <id>`.
LEAD_FILE_RETENTION_DAYS=30
# Account deletion: a closed account can be restored by its admin for this many days, then the daily job erases it.
# Raw uploaded cells outside the mapped columns are blanked after the org's own setting (default 30 days, Settings),
# only for uploads made since the org's rawRetentionSince; never retroactive (DEPLOY.md 7g).
# ACCOUNT_DELETE_AFTER_DAYS=30

# === Telegram (api: webhook and sign-in; worker: delivery; bot: long polling) =====

# From @BotFather. Unset = the bot is off everywhere (no webhook, no messages,
# Settings says it is not configured).
TELEGRAM_BOT_TOKEN=
# Webhook mode only: a random string Telegram echoes on every update. The
# webhook route refuses to run without it. Not needed for `npm run telegram:bot`.
TELEGRAM_WEBHOOK_SECRET=
# The bot's @username, shown on the Settings page. Required for "Telegram orqali kirish"
# (signs in the user who bound that Telegram account in Settings → Xavfsizlik; a Telegram account
# never seen before opens a confirmed 14-day trial account). Register the site's domain with
# BotFather (/setdomain) or the widget refuses to load (DEPLOY.md 7d).
TELEGRAM_BOT_USERNAME=
# Bot API endpoint. Default https://api.telegram.org; a self-hosted Bot API
# server lifts the 20 MB file limit.
# TELEGRAM_API_ROOT=

# === web (Next.js, apps/web) =====================================================
# NEXT_PUBLIC_* are inlined into the browser bundle at build time (Docker build args in
# docker-compose.yml): rebuild the web image after changing them.

# Where the browser calls the API. Empty = the page's own origin (Caddy routes /api/* to the api),
# which is what production uses; set an origin only if the API lives on another host.
NEXT_PUBLIC_API_URL=
# The address the web server itself uses to reach the API for server-side rendering (runtime,
# not inlined). docker-compose sets http://api:4000; for dev servers on the host use the line below.
# API_INTERNAL_URL=http://127.0.0.1:4000
# Public origin (https://...) for absolute Open Graph URLs — Telegram link
# previews need it. Unset is fine in development.
NEXT_PUBLIC_SITE_URL=

# Cites Tax Code art. 223 part 5 (1% fine) on the "Jarima" card, and shows the
# 1% fine estimate under "riskli qatorlar boʻyicha sotuv summasi" on reports
# whose file has a sales column. Leave false until a tax adviser has confirmed
# the wording against lex.uz.
NEXT_PUBLIC_SHOW_LEGAL_223=false

# "Demoni sinab koʻrish" target: an https URL or a site path such as /demo.
# Unset = every demo button and the header's Demo link are hidden.
NEXT_PUBLIC_DEMO_URL=/demo
# Telegram contact (https://t.me/...). Unset = hidden in header and footer.
NEXT_PUBLIC_TELEGRAM_URL=

# === Development and operator scripts ============================================

# Sign-in for the sample org created by `npm run seed` (development only).
# SEED_EMAIL=buxgalter@demo.uz
# SEED_PASSWORD=demo12345
# Where `npm run capture` takes screenshots from, and an installed browser to
# use (msedge | chrome) instead of downloading Playwright's Chromium.
# CAPTURE_BASE_URL=http://localhost:3000
# CAPTURE_CHANNEL=msedge
# Limits `npm run eval:translit` to the first N rows.
# TRANSLIT_LIMIT=

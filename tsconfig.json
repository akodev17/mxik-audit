{
  // scripts/ and eval/. Also the config tsx reads for everything run from the root (tests,
  // scripts), so "@/*" points at the web app for its tests. Workspaces have their own tsconfig.json.
  //
  // apps/worker is included because tsx applies this file's compilerOptions only to the files it
  // includes, and Nest's parameter decorators compile only with experimentalDecorators: without
  // these entries `tsx apps/worker/src/main.ts` and the apps/worker tests fail to transform.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "eval/**/*.ts",
    "apps/worker/src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

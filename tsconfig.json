{
  // scripts/ and eval/. Also the config tsx reads for everything run from the root (tests,
  // scripts), so "@/*" points at the web app for its tests. Workspaces have their own tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "eval/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

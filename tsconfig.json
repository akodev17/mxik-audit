{
  // scripts/, eval/ and tests/. Also the config tsx reads for everything run from the root (tests,
  // scripts), so "@/*" points at the web app for its tests and for tests/web-parity. Workspaces have
  // their own tsconfig.json.
  //
  // apps/api is included because tsx applies this file's compilerOptions only to the files it
  // includes, and Nest's parameter decorators compile only with experimentalDecorators: without
  // these entries `tsx apps/api/src/main.ts` and the apps/api tests fail to transform.
  // apps/worker is included because tsx applies this file's compilerOptions only to the files it
  // these entries `tsx apps/worker/src/main.ts` and the apps/worker tests fail to transform.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "paths": {
      "@/*": [
        "./apps/web/src/*"
      ]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "eval/**/*.ts",
    "tests/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/api/test/**/*.ts",
    "apps/worker/src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
